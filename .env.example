# Leave blank to use /api on the current origin; Vite proxies it to localhost:3000.
# Set to a backend/site root (for example, https://negusconsultants.com) to use a remote API.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:3000
# Add the matching Google OAuth web client ID to enable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
